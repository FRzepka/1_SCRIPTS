    <bib:Article rdf:about="https://linkinghub.elsevier.com/retrieve/pii/S0378775325014041">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>653</prism:volume>
                <dc:title>Journal of Power Sources</dc:title>
                <dc:identifier>DOI 10.1016/j.jpowsour.2025.237568</dc:identifier>
                <dcterms:alternative>Journal of Power Sources</dcterms:alternative>
                <dc:identifier>ISSN 03787753</dc:identifier>
            </bib:Journal>
        </dcterms:isPartOf>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Giazitzis</foaf:surname>
                        <foaf:givenName>Spyridon</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Isse</foaf:surname>
                        <foaf:givenName>Abdisamad Ahmed</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Blasuttigh</foaf:surname>
                        <foaf:givenName>Nicola</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Massi Pavan</foaf:surname>
                        <foaf:givenName>Alessandro</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Raimondo</foaf:surname>
                        <foaf:givenName>Davide M.</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Badha</foaf:surname>
                        <foaf:givenName>Susheel</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
