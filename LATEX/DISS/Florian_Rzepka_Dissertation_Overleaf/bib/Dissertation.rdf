        <dcterms:isReferencedBy rdf:resource="#item_309"/>
        <link:link rdf:resource="#item_308"/>
        <dc:title>Li-Ion Batteries Parameter Estimation With Tiny Neural Networks Embedded on Intelligent IoT Microcontrollers</dc:title>
        <dcterms:abstract>Das Paper schätzt die maximale entladbare Kapazität (und damit SOH) von Li-Ion-Batterien mit kleinen NN-Modellen (CNN, LSTM, GRU, Kombinationen). Die Modelle werden mit NASA-Daten trainiert und anschließend per STM32Cube.AI auf STM32-Mikrocontrollern eingebettet. Außerdem wird 8-Bit-Quantisierung analysiert und mit TensorFlow Lite for Microcontrollers verglichen.</dcterms:abstract>
        <dc:date>2020</dc:date>
        <z:libraryCatalog>DOI.org (Crossref)</z:libraryCatalog>
        <dc:identifier>
            <dcterms:URI>
                <rdf:value>https://ieeexplore.ieee.org/document/9133084/</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2025-05-19 14:27:02</dcterms:dateSubmitted>
        <dc:rights>https://creativecommons.org/licenses/by/4.0/legalcode</dc:rights>
        <bib:pages>122135-122146</bib:pages>
    </bib:Article>
    <bib:Journal rdf:about="urn:issn:2169-3536">
        <prism:volume>8</prism:volume>
        <dc:title>IEEE Access</dc:title>
        <dc:identifier>DOI 10.1109/ACCESS.2020.3007046</dc:identifier>
        <dcterms:alternative>IEEE Access</dcterms:alternative>
        <dc:identifier>ISSN 2169-3536</dc:identifier>
    </bib:Journal>
    <bib:Memo rdf:about="#item_309">
        <rdf:value>&lt;div data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;strong&gt;Zusammenfassung:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
SOH über maximale Kapazität (NASA-Datensatz, Entladezyklen)
&lt;/li&gt;
&lt;li&gt;
Tiny NNs: CNN, LSTM, GRU, CNN-LSTM, CNN-GRU
&lt;/li&gt;
&lt;li&gt;
Training + Vergleich mit RF und SVR (RMSE/MAE)
&lt;/li&gt;
&lt;li&gt;
Deployment via STM32Cube.AI auf STM32L4 (STWIN)
&lt;/li&gt;
&lt;li&gt;
PTQ auf INT8 (ss/sa), Vergleich von RAM, Flash, Zyklen, Energie
&lt;/li&gt;
&lt;li&gt;
Benchmark STM32Cube.AI vs TFLM (CNN-only)
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;Nachteile / Lücken ggü. &lt;em&gt;soc_outline&lt;/em&gt;:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
Nur SOH (Kapazität), kein SOC und kein gemeinsames SOC+SOH-Modell
&lt;/li&gt;
&lt;li&gt;
Zyklusweise Kapazitätsschätzung, kein echter Streaming-State-Estimator
&lt;/li&gt;
&lt;li&gt;
NASA-Zellen, kein DoD-/Aging-DoE mit LFP und variierenden Profilen wie bei dir
&lt;/li&gt;
&lt;li&gt;
Kein strukturiertes Pruning, nur Standard-PTQ über STM32Cube.AI
&lt;/li&gt;
&lt;li&gt;
Recurrent Layers bleiben FP32 (Quantisierung LSTM/GRU nicht unterstützt)
&lt;/li&gt;
&lt;li&gt;
Energie nur modelliert (Horowitz), keine reale Strommessung auf dem Board
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;Einordnung in &lt;em&gt;soc_outline&lt;/em&gt;:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
„Related Work – SOH/Capacity mit Tiny NNs auf STM32“
&lt;/li&gt;
&lt;li&gt;
„Embedded Deployment / Quantization“ → Beispiel für Cube.AI + PTQ, Vergleich zu deinem voll quantisierten, pruned Streaming-LSTM
&lt;/li&gt;
&lt;li&gt;
„Zielgröße / Output“ → Kontrast: direkte Kapazitäts-SOH-Schätzung vs. dein kombinierter SOC/SOH-Ansatz.
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;/p&gt;
&lt;p&gt;&lt;img alt=&quot;&quot; data-attachment-key=&quot;8PSAUWBQ&quot; width=&quot;736&quot; height=&quot;461&quot;&gt;&lt;img alt=&quot;&quot; data-attachment-key=&quot;VB6KSIQ2&quot; width=&quot;633&quot; height=&quot;455&quot;&gt;&lt;/p&gt;
&lt;p&gt;&lt;img alt=&quot;&quot; data-attachment-key=&quot;4DQXIPC6&quot; width=&quot;510&quot; height=&quot;362&quot;&gt;&lt;/p&gt;
&lt;p&gt;&lt;img alt=&quot;&quot; data-attachment-key=&quot;BEUGZ2SD&quot; width=&quot;506&quot; height=&quot;751&quot;&gt;&lt;/p&gt;
&lt;p&gt;&lt;img alt=&quot;&quot; data-attachment-key=&quot;K2Q4DWLK&quot; width=&quot;490&quot; height=&quot;516&quot;&gt;&lt;/p&gt;
&lt;p&gt;&lt;img alt=&quot;&quot; data-attachment-key=&quot;9VAVQRAH&quot; width=&quot;473&quot; height=&quot;534&quot;&gt;&lt;/p&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
