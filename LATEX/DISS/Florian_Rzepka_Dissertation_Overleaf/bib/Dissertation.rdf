        <dcterms:isReferencedBy rdf:resource="#item_275"/>
        <link:link rdf:resource="#item_274"/>
        <dc:subject>SOH</dc:subject>
        <dc:subject>Microcontroller</dc:subject>
        <dc:subject>Embedded AI</dc:subject>
        <dc:title>Novel SOH Estimation of Lithium-Ion Batteries for Real-Time Embedded Applications</dc:title>
        <dcterms:abstract>Dieses Paperschlägt eine SOH-Schätzung für Li-Ionen-Batterien vor, die Kapazität und Innenwiderstand gleichzeitig berücksichtigt. Dafür werden zwei sehr einfache, direkt messbare Health Indicators definiert und mit einem LSTM ausgewertet. Ziel ist eine echtzeitfähige, recheneinfache Lösung für Embedded-Anwendungen.</dcterms:abstract>
        <dc:date>12/2021</dc:date>
        <z:libraryCatalog>DOI.org (Crossref)</z:libraryCatalog>
        <dc:identifier>
            <dcterms:URI>
                <rdf:value>https://ieeexplore.ieee.org/document/9426956/</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2025-05-19 13:29:04</dcterms:dateSubmitted>
        <dc:rights>https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html</dc:rights>
        <bib:pages>206-209</bib:pages>
        <z:citationKey>Embedded_AI_SOH_badData</z:citationKey>
    </bib:Article>
    <bib:Journal rdf:about="urn:issn:1943-0663,%201943-0671">
        <prism:volume>13</prism:volume>
        <dc:title>IEEE Embedded Systems Letters</dc:title>
        <dc:identifier>DOI 10.1109/LES.2021.3078443</dc:identifier>
        <prism:number>4</prism:number>
        <dcterms:alternative>IEEE Embedded Syst. Lett.</dcterms:alternative>
        <dc:identifier>ISSN 1943-0663, 1943-0671</dc:identifier>
    </bib:Journal>
    <bib:Memo rdf:about="#item_275">
        <rdf:value>&lt;div data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;strong&gt;Zusammenfassung (sehr kurz):&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
SOH-Schätzung mit LSTM (SOHc + SOHr)
&lt;/li&gt;
&lt;li&gt;
HIs: erste Entlade-Spannung (Kapazität) &amp;amp; erste Lade-Spannung (IR)
&lt;/li&gt;
&lt;li&gt;
Datensätze: NASA + BEXEL, CC/CV-Zyklen
&lt;/li&gt;
&lt;li&gt;
Polynom-Fit zur Kombination von SOHc und SOHr
&lt;/li&gt;
&lt;li&gt;
RMSE-Verbesserung ggü. Ein-HI-Methoden, ~29 % kürzere Inferenzzeit (Simulink auf PC)
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;Nachteile / Lücken ggü. &lt;em&gt;soc_outline&lt;/em&gt;:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
Nur SOH, kein SOC (kein gemeinsamer SOC/SOH-Estimator)
&lt;/li&gt;
&lt;li&gt;
Kein Fahrprofil / Streaming-Betrieb, nur Zyklen (CC/CV)
&lt;/li&gt;
&lt;li&gt;
LSTM läuft auf PC (Simulink), kein echtes TinyML-Deployment auf MCU
&lt;/li&gt;
&lt;li&gt;
Keine strukturierten Pruning-Ansätze
&lt;/li&gt;
&lt;li&gt;
Keine explizite INT8-Implementierung / Speicherprofilierung auf konkretem STM32
&lt;/li&gt;
&lt;li&gt;
Keine DoD-Variation / Alterungs-DoE mit LFP-Zellen, nur NASA/BEXEL-Standardzellen
&lt;/li&gt;
&lt;li&gt;
schlechter Datensatz: Wenig Daten!
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;Einordnung in &lt;em&gt;soc_outline&lt;/em&gt;:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
„Related Work – SOH &amp;amp; Health Indicators für Embedded-Systeme“
&lt;/li&gt;
&lt;li&gt;
Gut als Beispiel für HI-basierte, einfache SOH-Features (erste Spannungswerte)
&lt;/li&gt;
&lt;li&gt;
Kontrast zu deinem Ansatz: du kombinierst SOC+SOH, Streaming-LSTM, Pruning + echte MCU-Inferenz.
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;/p&gt;
&lt;p&gt;&lt;img alt=&quot;&quot; data-attachment-key=&quot;KDY5EHA3&quot; width=&quot;484&quot; height=&quot;252&quot;&gt;&lt;/p&gt;
&lt;p&gt;&lt;img alt=&quot;&quot; data-attachment-key=&quot;HM9B3TLS&quot; width=&quot;489&quot; height=&quot;268&quot;&gt;&lt;/p&gt;
&lt;p&gt;&lt;img alt=&quot;&quot; data-attachment-key=&quot;XF2U7CWP&quot; width=&quot;496&quot; height=&quot;200&quot;&gt;&lt;/p&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
