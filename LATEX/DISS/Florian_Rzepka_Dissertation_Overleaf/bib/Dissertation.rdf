        <bib:pages>7412</bib:pages>
    </bib:Article>
    <bib:Journal rdf:about="urn:issn:2071-1050">
        <prism:volume>14</prism:volume>
        <dc:title>Sustainability</dc:title>
        <dc:identifier>DOI 10.3390/su14127412</dc:identifier>
        <prism:number>12</prism:number>
        <dcterms:alternative>Sustainability</dcterms:alternative>
        <dc:identifier>ISSN 2071-1050</dc:identifier>
    </bib:Journal>
    <bib:Memo rdf:about="#item_258">
        <rdf:value>&lt;div data-schema-version=&quot;9&quot;&gt;&lt;p&gt;&lt;strong&gt;Zusammenfassung:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
Online-SOC für 25 Ah Li-NMC
&lt;/li&gt;
&lt;li&gt;
2-RC-ECM, Parameter via FFRLS
&lt;/li&gt;
&lt;li&gt;
Algorithmen: EKF, AEKF, SPKF, UKF, LO, SMO, BPNN
&lt;/li&gt;
&lt;li&gt;
Testprofil: WLTP + Pulsentladung, 25 °C (Charakterisierung auch 5/45 °C)
&lt;/li&gt;
&lt;li&gt;
SOC: alle RMSE &amp;lt; 1.3 %, beste SMO RMSE ≈ 0.044 %, EKF RMSE ≈ 0.54 %
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;Im Vergleich zu &lt;em&gt;soc_outline&lt;/em&gt;:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
Nur SOC, kein SOH / keine kombinierte SOC+SOH-Schätzung
&lt;/li&gt;
&lt;li&gt;
Klassische modellbasierte Methoden + einfache BPNN, keine LSTM-/Streaming-NN
&lt;/li&gt;
&lt;li&gt;
Keine TinyML-/MCU-Implementierung, keine Quantisierung, kein Pruning
&lt;/li&gt;
&lt;li&gt;
Fokus auf frische Li-NMC-Zelle, kein LFP-DoE, keine Alterungsvariation
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;strong&gt;Einordnung in &lt;em&gt;soc_outline&lt;/em&gt;:&lt;/strong&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
Abschnitt „Introduction / Related Work – Online-SOC mit KF/Observer/ANN“
&lt;/li&gt;
&lt;li&gt;
Referenz für Trade-off SOC-Genauigkeit vs. Rechenaufwand als Motivation für deinen kompakten Streaming-NN-Ansatz auf MCU.
&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
