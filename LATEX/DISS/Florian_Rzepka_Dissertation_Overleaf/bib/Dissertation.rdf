        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:2332-7782,%202372-2088"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
