        <dc:subject>SOC</dc:subject>
        <dc:subject>Microcontroller</dc:subject>
        <dc:subject>Embedded AI</dc:subject>
        <dc:title>Tiny Machine Learning Battery State-of-Charge Estimation Hardware Accelerated</dc:title>
        <dc:date>2024-07-18</dc:date>
        <z:language>en</z:language>
        <z:libraryCatalog>DOI.org (Crossref)</z:libraryCatalog>
        <dc:identifier>
            <dcterms:URI>
               <rdf:value>https://www.mdpi.com/2076-3417/14/14/6240</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2025-05-19 13:06:08</dcterms:dateSubmitted>
        <dc:rights>https://creativecommons.org/licenses/by/4.0/</dc:rights>
        <bib:pages>6240</bib:pages>
        <z:citationKey>Embedded_AI_only_SOC_mobile</z:citationKey>
    </bib:Article>
    <bib:Journal rdf:about="urn:issn:2076-3417">
        <prism:volume>14</prism:volume>
        <dc:title>Applied Sciences</dc:title>
        <dc:identifier>DOI 10.3390/app14146240</dc:identifier>
        <prism:number>14</prism:number>
        <dcterms:alternative>Applied Sciences</dcterms:alternative>
        <dc:identifier>ISSN 2076-3417</dc:identifier>
    </bib:Journal>
    <bib:Memo rdf:about="#item_333">
        <rdf:value>&lt;div data-schema-version=&quot;9&quot;&gt;&lt;p&gt;Zusammenfassung Pau &amp;amp; Aniballi (2024):&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
TinyML-SoC-Schätzung für EV-Batterien
&lt;/li&gt;
&lt;li&gt;
Vergleich vieler NN-Modelle (FNN, LSTM, GRU, TCN, LMU)
&lt;/li&gt;
&lt;li&gt;
BMW i3-Fahrzyklen, Fenster 100×10 Features
&lt;/li&gt;
&lt;li&gt;
Deployment &amp;amp; Speicher/Runtime-Profiling auf ST-MCUs/MPUs
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Nachteile ggü. &lt;em&gt;soc_outline&lt;/em&gt;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
Nur SoC, kein SoH
&lt;/li&gt;
&lt;li&gt;
Kein echter stateful Streaming-Betrieb, nur Sliding Window
&lt;/li&gt;
&lt;li&gt;
Kein strukturiertes Pruning
&lt;/li&gt;
&lt;li&gt;
Quantisierung nur TFLite/PTQ, keine manuelle INT8-LSTM-Implementierung in C
&lt;/li&gt;
&lt;li&gt;
Keine HIL-Messungen zu Energie/Latency wie bei STM32H7 in &lt;em&gt;soc_outline&lt;/em&gt;
&lt;/li&gt;
&lt;li&gt;
Datensatz: Fahrprofil BMW i3, kein DoD-Aging-DoE mit LFP-Zellen
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Einordnung in &lt;em&gt;soc_outline&lt;/em&gt;:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
Hauptsächlich „Related Work / TinyML für SOC/SOH“
&lt;/li&gt;
&lt;li&gt;
Kurzer Verweis in „Embedded Deployment / MCU Benchmarks“ als Beispiel für automatisierte STM32Cube.AI-Toolchain ohne stateful LSTM &amp;amp; Pruning.
&lt;/li&gt;
&lt;/ul&gt;
&lt;/div&gt;</rdf:value>
    </bib:Memo>
