@article{Umegaki.2017,
 abstract = {In order to study a diffusive behavior of Li+ in Li intercalated graphites, we have measured muon spin relaxation (\textgreek{m}+SR) spectra for C6Li and C12Li synthesized with an electrochemical reaction between Li and graphite in a Li-ion battery. For both compounds, it was found that Li+ ions start to diffuse above 230 K and the diffusive behavior obeys a thermal activation process. The activation energy (Ea) for C6Li is obtained as 270(5) meV, while Ea = 170(20) meV for C12Li. Assuming a jump diffusion of Li+ in the Li layer of C6Li and C12Li, a self-diffusion coefficient DLi at 310 K was estimated as 7.6(3) $\times$ 10-11 (cm2 s-1) in C6Li and 14.6(4) $\times$ 10-11 (cm2 s-1) in C12Li.},
 author = {Umegaki, Izumi and Kawauchi, Shigehiro and Sawada, Hiroshi and Nozaki, Hiroshi and Higuchi, Yuki and Miwa, Kazutoshi and Kondo, Yasuhito and M{\aa}nsson, Martin and Telling, Mark and Coomer, Fiona C. and Cottrell, Stephen P. and Sasaki, Tsuyoshi and Kobayashi, Tetsuro and Sugiyama, Jun},
 year = {2017},
 title = {Li-ion diffusion in Li intercalated graphite C6Li and C12Li probed by \textgreek{m}+SR},
 pages = {19058--19066},
 volume = {19},
 number = {29},
 journal = {Physical chemistry chemical physics : PCCP},
 doi = {10.1039/c7cp02047c},
