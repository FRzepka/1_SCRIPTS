@article{sahriEnergyManagementSystem2021,
  title = {Energy {{Management System}} for {{Hybrid PV}}/{{Wind}}/{{Battery}}/{{Fuel Cell}} in {{Microgrid-Based Hydrogen}} and {{Economical Hybrid Battery}}/{{Super Capacitor Energy Storage}}},
  author = {Sahri, Younes and Belkhier, Youcef and Tamalouzt, Salah and Ullah, Nasim and Shaw, Rabindra Nath and Chowdhury, Md. Shahariar and Techato, Kuaanan},
