	doi = {10.1155/2015/719490},
	abstract = {State of charge (SOC) is one of the most important parameters in battery management system (BMS). There are numerous algorithms for SOC estimation, mostly of model-based observer/filter types such as Kalman filters, closed-loop observers, and robust observers. Modeling errors and measurement noises have critical impact on accuracy of SOC estimation in these algorithms. This paper is a comparative study of robustness of SOC estimation algorithms against modeling errors and measurement noises. By using a typical battery platform for vehicle applications with sensor noise and battery aging characterization, three popular and representative SOC estimation methods (extended Kalman filter, PI-controlled observer, and
              
                
                  
                    
                      H
                    
                    
                      ∞
                    
                  
                
              
              observer) are compared on such robustness. The simulation and experimental results demonstrate that deterioration of SOC estimation accuracy under modeling errors resulted from aging and larger measurement noise, which is quantitatively characterized. The findings of this paper provide useful information on the following aspects: (1) how SOC estimation accuracy depends on modeling reliability and voltage measurement accuracy; (2) pros and cons of typical SOC estimators in their robustness and reliability; (3) guidelines for requirements on battery system identification and sensor selections.},
	language = {en},
	urldate = {2026-03-23},
	journal = {Mathematical Problems in Engineering},
	author = {Li, Xue and Jiang, Jiuchun and Zhang, Caiping and Wang, Le Yi and Zheng, Linfeng},
	year = {2015},
	pages = {1--14},
	annote = {Inhalt
Das Paper untersucht die Robustheit verschiedener SOC-Schätzverfahren gegenüber Modellfehlern (insbesondere durch Alterung) und Messrauschen. Ziel ist ein quantitativer Vergleich etablierter Methoden hinsichtlich Genauigkeit und Praxistauglichkeit im BMS-Kontext.

Methodik
