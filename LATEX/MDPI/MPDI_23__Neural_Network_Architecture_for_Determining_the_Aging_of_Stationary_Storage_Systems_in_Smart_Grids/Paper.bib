@inproceedings{Birou.2020,
 abstract = {Predicting ageing and performance of storage devices is important for microgrids to promote grid services like self-consumption.

A techno-economic tool is used to model a microgrid composed of solar panels, a second life lithium-ion battery, and power consumers.

The tool simulates the microgrid's behavior over several years and gives economic indicators for the system's profitability.

The battery model includes a behavioral model to simulate voltage and state of charge and an aging model to predict capacity and power losses during cycling.

The analysis shows the sensitivity of storage performance and cost to economic parameters and the importance of degrading the model parameters with aging.

The study presents optimistic trends for the future of second-life batteries.},
 author = {Birou, Camille and Roboam, Xavier and Radet, Hugo and Lacressonniere, Fabien},
 title = {Techno-economic analysis of second-life lithium-ion batteries integration in microgrids},
